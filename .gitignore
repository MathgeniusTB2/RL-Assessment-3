# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/

# Flatland / RL artifacts
results/
outputs/
runs/
checkpoints/
*.pkl
*.pt
*.pth
*.ckpt

# Data / renders
*.csv
*.gif
*.mp4

# Logs / scheduler output
*.log
*.o*
*.e*

# Committed scenario artifacts (otherwise ignored by the patterns above)
!docs/comparison/*.gif
!data/levels/*.pkl

# Tooling caches
.firecrawl/

# OS / editor
.DS_Store
.vscode/
.idea/
